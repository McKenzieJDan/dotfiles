<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.mckenz.weekly-cleanup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>__DOTFILES_DIR__/weekly-cleanup.sh</string>
    </array>

    <!-- Sundays at 03:15. launchd runs on next wake if the Mac was asleep. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <!-- Same file the script logs to, so pre-exec errors (e.g. zsh startup) land in one place. -->
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/weekly-cleanup.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/weekly-cleanup.log</string>
</dict>
</plist>
