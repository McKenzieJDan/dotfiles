# Navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias ~="cd ~"
alias -- -="cd -"

# List files
alias ls="eza --icons=auto"
alias ll="eza -la --icons=auto --git"
alias la="eza -la --icons=auto"
alias lt="eza -T --icons=auto"
alias l="eza -l --icons=auto"

# Git
alias g="git"
alias gs="git status"
alias ga="git add"
alias gc="git commit"
alias gco="git checkout"
alias gb="git branch"
alias gp="git push"
alias gl="git pull"
alias gd="git diff"
alias glog="git log --oneline --graph --decorate"

# Homebrew
alias brewup="brew update && brew upgrade && brew cleanup"
alias cask="brew install --cask"

# System
alias reload="source ~/.zshrc"
alias cls="clear"
alias q="exit"

# Network
alias ip="curl -s ipinfo.io/ip"
alias localip="ipconfig getifaddr en0"
# Not an override of ping itself, so a continuous ping still works.
alias ping5="ping -c 5"

# Development
alias python="python3"
alias pip="pip3"
alias serve="python3 -m http.server --bind 127.0.0.1"
alias json="pbpaste | jq ."
alias code="cursor"

# Utilities
alias top="htop"
alias tree="tree -C"

# macOS
alias showfiles="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
alias hidefiles="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"
alias desktop="cd ~/Desktop"
alias downloads="cd ~/Downloads"
alias documents="cd ~/Documents"
alias cgit="cd ~/git"

# Quick edit configs
alias zshconfig="$EDITOR ~/.zshrc"
alias aliases="$EDITOR ~/.config/zsh/.aliases"
alias functions="$EDITOR ~/.config/zsh/.functions"
alias gitconfig="$EDITOR ~/.gitconfig"

# Dotfiles management
# Resolved from this file's own location, so moving the repo keeps it working.
DOTFILES_DIR="${${(%):-%N}:A:h:h:h}"
alias update-everything="$DOTFILES_DIR/update-everything.sh"
alias cleanup="$DOTFILES_DIR/cleanup.sh"
alias dotfiles="cd $DOTFILES_DIR"

# Backup management
alias backups="open http://127.0.0.1:9898/"

# SSH shortcuts
alias mc="minecraft"
