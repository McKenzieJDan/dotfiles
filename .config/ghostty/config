# Ghostty config
# Docs: https://ghostty.org/docs/config
# List all options: ghostty +show-config --default --docs
# Reload config: cmd+shift+,

# --- Font & appearance ---
# JetBrains Mono is bundled with Ghostty (incl. Nerd Font symbol fallback),
# so eza/prompt icons work without installing anything.
font-size = 13
cursor-style = block
cursor-style-blink = false
background-opacity = 0.97
background-blur = 20
minimum-contrast = 1.1

# Theme (always dark; for auto-switching with macOS appearance use:
# theme = light:Catppuccin Latte,dark:Catppuccin Mocha)
theme = Catppuccin Mocha

# --- Window ---
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
macos-titlebar-style = tabs
window-save-state = always
unfocused-split-opacity = 0.85

# --- Behavior ---
# Left option acts as alt so alt+b/alt+f word-jumping works in zsh;
# right option stays for typing special characters
macos-option-as-alt = left
# Alt-click (or plain click at the prompt) moves the cursor there
cursor-click-to-move = true
# Flash the dock icon when a background tab's command finishes
bell-features = attention,title
copy-on-select = clipboard
mouse-hide-while-typing = true
confirm-close-surface = false
scrollback-limit = 20000000
auto-update = check

# Shell integration (auto-detects zsh)
shell-integration-features = cursor,sudo,title

# --- Quick terminal (dropdown from top of screen) ---
# Global hotkey works even when Ghostty isn't focused;
# macOS will prompt once for Accessibility permission.
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.1

# --- Keybindings: splits ---
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+ctrl+left=resize_split:left,40
keybind = cmd+ctrl+right=resize_split:right,40
keybind = cmd+ctrl+up=resize_split:up,40
keybind = cmd+ctrl+down=resize_split:down,40
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+ctrl+equal=equalize_splits

# --- Keybindings: navigation (uses shell integration prompt marks) ---
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1

# Shift+enter inserts a newline instead of submitting —
# essential for multiline prompts in Claude Code
keybind = shift+enter=text:\n

# Send the raw ctrl+v byte (0x16) so Claude Code's image paste works
keybind = ctrl+v=text:\x16
