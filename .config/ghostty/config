# Ghostty config
# Docs: https://ghostty.org/docs/config
# List all options: ghostty +show-config --default --docs
# Reload config: cmd+shift+,

# --- Font & appearance ---
# JetBrains Mono is bundled with Ghostty (incl. Nerd Font symbol fallback),
# so eza/prompt icons work without installing anything.
font-size = 13
cursor-style = block
cursor-style-blink = false
background-opacity = 0.97
background-blur = 20
minimum-contrast = 1.1

# Theme (always dark; for auto-switching with macOS appearance use:
# theme = light:Catppuccin Latte,dark:Catppuccin Mocha)
theme = Catppuccin Mocha

# --- Window ---
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
macos-titlebar-style = tabs
window-save-state = always
unfocused-split-opacity = 0.85

# --- Behavior ---
# Left option acts as alt so alt+b/alt+f word-jumping works in zsh;
# right option stays for typing special characters
macos-option-as-alt = left
# Alt-click (or plain click at the prompt) moves the cursor there
cursor-click-to-move = true
# Flash the dock icon when a background tab's command finishes
bell-features = attention,title
copy-on-select = clipboard
mouse-hide-while-typing = true
confirm-close-surface = false
scrollback-limit = 20000000
auto-update = check

# Shell integration (auto-detects zsh)
shell-integration-features = cursor,sudo,title

# --- Quick terminal (dropdown from top of screen) ---
# Global hotkey works even when Ghostty isn't focused;
# macOS will prompt once for Accessibility permission.
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.1

# --- Keybindings: splits ---
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+ctrl+left=resize_split:left,40
keybind = cmd+ctrl+right=resize_split:right,40
keybind = cmd+ctrl+up=resize_split:up,40
keybind = cmd+ctrl+down=resize_split:down,40
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+ctrl+equal=equalize_splits
# Hovering over a split focuses it
focus-follows-mouse = true

# --- Pane mode: cmd+s, then single keys; escape to leave ---
# h/j/k/l or arrows: move    shift+h/j/k/l or shift+arrows: resize
# v: split right    s: split down    x: close split
# z: zoom    =: equalize
keybind = cmd+s=activate_key_table:pane
keybind = pane/
keybind = pane/h=goto_split:left
keybind = pane/j=goto_split:down
keybind = pane/k=goto_split:up
keybind = pane/l=goto_split:right
keybind = pane/left=goto_split:left
keybind = pane/down=goto_split:down
keybind = pane/up=goto_split:up
keybind = pane/right=goto_split:right
keybind = pane/shift+h=resize_split:left,40
keybind = pane/shift+j=resize_split:down,40
keybind = pane/shift+k=resize_split:up,40
keybind = pane/shift+l=resize_split:right,40
keybind = pane/shift+left=resize_split:left,40
keybind = pane/shift+down=resize_split:down,40
keybind = pane/shift+up=resize_split:up,40
keybind = pane/shift+right=resize_split:right,40
keybind = pane/v=new_split:right
keybind = chain=deactivate_key_table
keybind = pane/s=new_split:down
keybind = chain=deactivate_key_table
keybind = pane/x=close_surface
keybind = chain=deactivate_key_table
keybind = pane/z=toggle_split_zoom
keybind = pane/equal=equalize_splits
keybind = pane/escape=deactivate_key_table
keybind = pane/enter=deactivate_key_table
# Stray keys do nothing instead of typing into the shell
keybind = pane/catch_all=ignore

# --- Keybindings: tabs ---
# Defaults: cmd+t new, cmd+1..8 go to tab, cmd+9 last tab,
# cmd+shift+[ / ] or ctrl+tab / ctrl+shift+tab previous / next
keybind = cmd+shift+left=move_tab:-1
keybind = cmd+shift+right=move_tab:1
keybind = cmd+shift+r=prompt_tab_title

# --- Keybindings: navigation (uses shell integration prompt marks) ---
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1

# Shift+enter inserts a newline instead of submitting —
# essential for multiline prompts in Claude Code
keybind = shift+enter=text:\n

# Send the raw ctrl+v byte (0x16) so Claude Code's image paste works
keybind = ctrl+v=text:\x16
